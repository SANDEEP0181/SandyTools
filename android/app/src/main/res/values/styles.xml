<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SandyTools" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sandytools_blue</item>
        <item name="android:navigationBarColor">@color/sandytools_white</item>
        <item name="android:statusBarColor">@color/sandytools_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/sandytools_blue</item>
    </style>
    <style name="Theme.SandyTools.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sandytools_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sandytools_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.SandyTools</item>
    </style>
</resources>